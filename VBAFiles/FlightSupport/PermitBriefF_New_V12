Private Sub HandleCountriesCmbUpdate(cmb As ComboBox, permitValidityControl As Control, vendorComboBox As ComboBox)
    Dim selectedValue As Variant
    selectedValue = cmb.Value ' Get the selected value from the combo box

    ' Check if selected value is not null
    If Not IsNull(selectedValue) Then
        ' Call PermitValidity function
        PermitValidity_sub selectedValue, permitValidityControl
        ' Call Operationalprocedures function
        Operationalprocedures_sub selectedValue, vendorComboBox
    Else
        permitValidityControl.Value = Null ' Clear the specific PermitValidity control
        vendorComboBox.RowSource = "" ' Clear the vendor combo box
    End If
End Sub

Private Sub PermitValidity_sub(selectedValue As Variant, permitValidityControl As Control)
    Dim rs As DAO.Recordset
    Set rs = CurrentDb.OpenRecordset("SELECT * FROM CountriesT_New WHERE COUNTRY = '" & selectedValue & "'", dbOpenSnapshot)

    If Not rs.EOF Then
        permitValidityControl.Value = rs("OVF_PermitValidity").Value ' Set the specific PermitValidity control
    Else
        permitValidityControl.Value = "+24"
    End If
    rs.Close
    Set rs = Nothing
End Sub

Private Sub Operationalprocedures_sub(selectedValue As Variant, vendorComboBox As ComboBox)
    Dim rs As DAO.Recordset
    Dim msgText As String
    Dim VendorsQ As String
    Dim SelectedVendors As Boolean
    
    SelectedVendors = True

    ' Validate input
    If IsNull(selectedValue) Or selectedValue = "" Then
        MsgBox "Please select a valid country.", vbExclamation
        Exit Sub
    End If
    
    Set rs = CurrentDb.OpenRecordset("SELECT * FROM CountriesT_New WHERE COUNTRY = '" & selectedValue & "'", dbOpenSnapshot)
    
    ' Update the rowsource of the vendor combo box
    If Not rs.EOF Then
        msgText = Nz(rs!OVF_OperationalNotes, "Selected country does not have operational procedures.")
        MsgBox msgText, vbInformation, "Operational Procedures"
        
        ' Set the RowSource for the specific vendor combo box
        vendorComboBox.RowSource = "SELECT Vendor FROM vendorsT WHERE Permits = " & SelectedVendors & " OR AllServices = " & SelectedVendors
    Else
        MsgBox "Selected country does not have operational procedures.", vbInformation, "Operational Procedures"
        vendorComboBox.RowSource = "" ' Clear the vendor combo box if no operational procedures
    End If

CleanUp:
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
    Exit Sub
End Sub
