Private Sub AddPermit_Click()
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim strSQL As String
    Dim Service As String, Vendor As String, ServiceStatus As String, PaymentMethod As String
    Dim PermitNo As Variant, Sect_ID As Variant, PermitType As String, PermitValidity As String
    Dim i As Integer ' Declare Loop control variable

    Set db = CurrentDb
    Set rs = db.OpenRecordset("PermitBriefT_New", dbOpenDynaset)

    ' Loop through the sets of text boxes And add records
    For i = 1 To 5 ' Change 5 To the desired number of services

        ' Retrieve values from text boxes
        Service = Nz(Me.Controls("CountriesCmb" & i).Value, "")
        Vendor = Nz(Me.Controls("Vendor" & i).Value, "")
        ServiceStatus = Nz(Me.Controls("ServiceStatus" & i).Value, "")
        PaymentMethod = Nz(Me.Controls("PaymentMethod" & i).Value, "")
        PermitType = Nz(Me.Controls("PermitType" & i).Value, "")
        PermitNo = Nz(Me.Controls("PermitNumber" & i).Value, "")
        Sect_ID = Nz(Me.Controls("Sect_ID" & i).Value, "") ' Correct reference
        PermitValidity = Nz(Me.Controls("PermitValidity" & i).Value, "")
        ' Check If at least one field is Not empty
        If Service <> "" Or Vendor <> "" Or ServiceStatus <> "" Or PermitType <> "" Or PaymentMethod <> "" Or Sect_ID <> "" Then
            ' Check If a record With the same Service And Sect_ID already exists
        If DCount("*", "PermitBriefT_New", "Country_Location = '" & Service & "' And Sect_ID = " & Sect_ID & " And PermitType = '" & PermitType & "'") > 0 Then
            MsgBox "A record with the same Service, Sect_ID, and PermitType already exists.", vbExclamation, "Duplicate Record"
            Exit Sub ' Exit the Sub if duplicate found
        Else

                ' Add a record
                rs.AddNew
                ' Assign values To the fields in the table
                rs.Fields("Country_Location").Value = Service
                rs.Fields("Vendor").Value = Vendor
                rs.Fields("PermitStatus").Value = ServiceStatus
                rs.Fields("PaymentMethod").Value = PaymentMethod
                rs.Fields("PermitType").Value = PermitType
                rs.Fields("PermitNumber").Value = PermitNo
                rs.Fields("PermitValidity").Value = PermitValidity
                rs.Fields("Sect_ID").Value = Me.Controls("Sect_ID" & i).Column(1) ' Access Column(1)
                rs.Update
            End If
        End If

        ' Clear the text boxes after adding a record
        Me.Controls("CountriesCmb" & i).Value = Null
        Me.Controls("Vendor" & i).Value = Null
        Me.Controls("ServiceStatus" & i).Value = Null
        Me.Controls("PaymentMethod" & i).Value = Null
        Me.Controls("PermitType" & i).Value = Null
        Me.Controls("PermitNumber" & i).Value = Null
        Me.Controls("PermitValidity" & i).Value = Null
        Me.Controls("Sect_ID" & i).Value = Null
    Next i

    ' Clean up
    rs.Close
    Set rs = Nothing
    Set db = Nothing
    MsgBox "Service records added successfully.", vbInformation
End Sub

